from transformers import pipeline
import pandas as pd
from tqdm import tqdm

# Cargar el modelo de zero-shot classification
classifier = pipeline("zero-shot-classification", model="facebook/bart-large-mnli")

# Emociones como etiquetas de análisis de sentimiento
sentiment_labels = [
    "very positive", "positive", "neutral", "negative", "very negative",
    "melancholy", "bittersweet", "anxious", "contemplative"
]

# Temas extendidos
themes_comprehensive = [
    # Philosophy
    "Environmental Harmony", "Moral Ambiguity", "Pacifism", "Spiritual Connection",
    "Acceptance of Death", "Intergenerational Wisdom", "Collective Responsibility",
    
    # Narrative
    "Hero's Journey", "Clear Antagonist", "Romantic Resolution", "Magical Transformation",
    "Comic Relief", "Musical Expression", "Happy Ending",
    
    # Cultural
    "Western Individualism", "Japanese Collectivism", "Capitalist Success", 
    "Traditional Values", "Technology Skepticism", "Nature Worship",
    
    # Characters
    "Female Empowerment", "Child Wisdom", "Elderly Guidance", "Moral Complexity",
    "Working Class Dignity", "Parental Absence", "Animal Symbolism",
    
    # Emotional
    "Melancholy", "Environmental Anxiety", "Cultural Identity", 
    "Quiet Contemplation", "Bittersweet Ending"
]

# Leer las frases
with open("data_in_sentences/ghibli/Castle.in.the.Sky_cleaned_sentences.txt", "r", encoding="utf-8") as f:
    lines = [line.strip() for line in f if line.strip()]

results = []

for line in tqdm(lines, desc="Classifying themes and sentiment"):
    # Sentiment prediction
    sent_result = classifier(line, sentiment_labels, multi_label=True)
    top_sentiment = sent_result["labels"][0]
    sentiment_score = sent_result["scores"][0]

    # Theme prediction
    theme_result = classifier(line, themes_comprehensive, multi_label=True)
    top_theme = theme_result["labels"][0]
    theme_score = theme_result["scores"][0]

    results.append({
        "text": line,
        "sentiment": top_sentiment,
        "sentiment_score": round(sentiment_score, 4),
        "theme": top_theme,
        "theme_score": round(theme_score, 4),
        "length": len(line.split())
    })

# Guardar CSV
df = pd.DataFrame(results)
df.to_csv("Castle.in.the.Sky_zero_shot_sentiment_and_theme.csv", index=False)
print(df.head())
